classDiagram
    class TaskKind {
        <<enumeration>>
        PERSONAL
        EVENT
    }

    class ActivityType {
        <<enumeration>>
        WALK
        BATH
        GROOMING
        VET_VISIT
    }

    class TaskPriority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class TaskStatus {
        <<enumeration>>
        PENDING
        DONE
    }

    class TaskFrequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Owner {
        +int id
        +String name
        +list pet_ids
        +list task_ids
        +add_pet(pet_id) void
        +create_task(task) Task
    }

    class Pet {
        +int id
        +String name
        +String breed
        +int age
        +String species
        +list owner_ids
        +list task_ids
        +get_tasks() list
        +get_owners() list
    }

    class Task {
        +int id
        +int pet_id
        +TaskKind task_kind
        +ActivityType activity
        +TaskPriority priority
        +int duration_minutes
        +TaskStatus status
        +DateTime scheduled_at
        +String description
        +TaskFrequency frequency
        +int owner_id
        +mark_complete() void
        +is_pending() bool
        +is_shared() bool
    }

    class Scheduler {
        +dict owners
        +dict pets
        +dict tasks
        +add_owner(owner) void
        +add_pet(pet, owner_id) void
        +add_task(task) String
        +get_tasks_for_pet(pet_id) list
        +get_todays_schedule(owner_id) list
        +sort_by_time(tasks) list
        +filter_tasks(tasks, pet_id, status) list
        +get_conflicts(tasks) list
        +mark_task_complete(task_id) Task
    }

    Owner "*" -- "*" Pet : has
    Pet "1" --> "*" Task : has
    Owner "1" --> "0..*" Task : has
    Scheduler "1" --> "*" Owner : manages
    Scheduler "1" --> "*" Pet : manages
    Scheduler "1" --> "*" Task : manages
